<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.akios.apps</string>
	<!-- the Metal test application (share/system-apps, kept on the owner's word) installed by installd at every start
	     (11-28: iOS 27's LaunchServices refuses registerApplicationDictionary; lsreg -I is installd's own client, which
	     needs this job's domain, the mobile user's, to reach com.apple.mobile.installd). 30 s in. -->
	<key>ProgramArguments</key>
	<array>
		<string>/akita/bin/lsreg</string>
		<string>-w</string>
		<string>30</string>
		<string>-I</string>
		<string>/private/preboot/akita/share/system-apps/MetalTest.app</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
