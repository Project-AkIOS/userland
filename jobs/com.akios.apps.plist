<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.akios.apps</string>
	<!-- the applications the image carries told to LaunchServices at every start: the Metal test application
	     (share/system-apps, kept on the owner's word). lsreg -w: 25 s in, a failed registration tried again.
	     Registered already: said so, nothing done. -->
	<key>ProgramArguments</key>
	<array>
		<string>/akita/bin/lsreg</string>
		<string>-w</string>
		<string>25</string>
		<string>/private/preboot/akita/share/system-apps/MetalTest.app</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
